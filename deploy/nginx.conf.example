# Alternative to Caddy. Replace certificate paths with the files managed by
# Certbot (or another ACME client). Access logging is disabled so callback query
# strings containing one-time OAuth codes are not persisted.
server {
    listen 80;
    listen [::]:80;
    server_name threads-auth.adigitalnyc.com;
    access_log off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name threads-auth.adigitalnyc.com;

    ssl_certificate /etc/letsencrypt/live/threads-auth.adigitalnyc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/threads-auth.adigitalnyc.com/privkey.pem;

    access_log off;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
