[Unit]
Description=Threads Monitor Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=threadsbot
WorkingDirectory=/opt/threads_bot
ExecStart=/opt/threads_bot/.venv/bin/python /opt/threads_bot/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/threads_bot/data

[Install]
WantedBy=multi-user.target
