# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot. Keep this non-empty.
ALLOWED_USER_IDS=
# Explicit OAuth administrators. If empty, ALLOWED_USER_IDS is used.
THREADS_OAUTH_ADMIN_USER_IDS=
# Numeric ID of the one internal chat that receives watcher notifications.
# Group/supergroup IDs are usually negative (for example -1001234567890).
THREADS_PRIMARY_CHAT_ID=

# Threads OAuth (use the Threads App ID and Threads App Secret shown in the
# "Access the Threads API" use case, not credentials for another Meta product).
THREADS_APP_ID=
THREADS_APP_SECRET=
# Generate once with:
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up securely. Changing it makes existing encrypted tokens unreadable.
THREADS_TOKEN_ENCRYPTION_KEY=

# Public OAuth URLs
PUBLIC_BASE_URL=https://threads-auth.adigitalnyc.com
THREADS_REDIRECT_URI=https://threads-auth.adigitalnyc.com/oauth/threads/callback
THREADS_OAUTH_AUTHORIZE_URL=https://threads.net/oauth/authorize
THREADS_GRAPH_BASE=https://graph.threads.net
THREADS_API_BASE=https://graph.threads.net/v1.0

# OAuth state and long-lived token maintenance
THREADS_OAUTH_STATE_TTL_MINUTES=10
THREADS_TOKEN_REFRESH_BEFORE_DAYS=7
THREADS_TOKEN_REFRESH_CHECK_HOURS=6

# Temporary Meta App Review access. Generate a raw code and its SHA-256 hash with:
# .venv/bin/python scripts/generate_review_access.py --bot-username your_bot
# Put only the hash and an explicit UTC expiry on the server. Give the raw deep
# link only to Meta in the App Review instructions. Leave both empty when review
# access is disabled.
THREADS_REVIEW_ACCESS_CODE_HASH=
THREADS_REVIEW_ACCESS_EXPIRES_AT=

# Internal HTTP listener. Keep loopback-only behind Caddy or Nginx.
OAUTH_SERVER_HOST=127.0.0.1
OAUTH_SERVER_PORT=8080

# Database
DATABASE_PATH=./data/bot.db

# Default search settings
DEFAULT_SEARCH_TYPE=RECENT
DEFAULT_SEARCH_LIMIT=25

# Default poll interval (minutes) until changed via /interval in the bot
POLL_INTERVAL_MINUTES=15

# Log Threads keyword_search URL, status, and truncated response body.
# Tokens and Authorization headers are never logged. Leave off in normal operation.
THREADS_API_DEBUG=false
